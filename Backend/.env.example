# APIForge Server Configuration
PORT=3001
REQUEST_TIMEOUT=30000
NODE_ENV=production
OUTBOUND_REQUEST_SAFE_MODE=true

# AI Provider Configuration (optional - users can also supply their own key in the UI settings)
AI_PROVIDER=google-gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# MongoDB Persistence
MONGODB_URI=mongodb://localhost:27017/apiforge

# JWT Secret (generate with: openssl rand -hex 32)
JWT_SECRET=replace_with_a_secure_random_32_byte_secret

# Allowed CORS origins (comma-separated URLs)
FRONTEND_URL=http://localhost:5173

