# APIForge Server Configuration
PORT=3001
REQUEST_TIMEOUT=30000
NODE_ENV=production
OUTBOUND_REQUEST_SAFE_MODE=true

# AI Provider Configuration (Bring-Your-Own-Key model: users supply their key in the in-app Settings UI)
AI_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# MongoDB Persistence
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority

# JWT Secret (generate with: openssl rand -hex 32 or node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=replace_with_a_secure_random_32_byte_secret

# Allowed CORS origins (comma-separated URLs)
FRONTEND_URL=https://apiforge-rust.vercel.app,https://*.vercel.app,http://localhost:5173
