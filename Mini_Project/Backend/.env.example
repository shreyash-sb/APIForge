PORT=3001
REQUEST_TIMEOUT=30000
NODE_ENV=development
# Set true when this backend is exposed beyond controlled local development.
# Blocks obvious loopback, private, link-local, and metadata-service IP literals.
# Hostname DNS rebinding is intentionally not resolved by this application layer.
OUTBOUND_REQUEST_SAFE_MODE=false

# ─── Phase 7: AI Diagnosis ────────────────────────────────────────────────
# AI_PROVIDER selects the provider: "mock" (default, no key required) or "google-gemini"
AI_PROVIDER=mock
# GEMINI_API_KEY is required only when AI_PROVIDER=google-gemini
# GEMINI_API_KEY=your-key-here
# GEMINI_MODEL controls the Gemini model (default: gemini-2.0-flash)
# GEMINI_MODEL=gemini-2.0-flash
