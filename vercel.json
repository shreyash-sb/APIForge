{
  "buildCommand": "npm run build:frontend",
  "outputDirectory": "Frontend/dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://apiforge-production-cb58.up.railway.app/api/:path*"
    },
    {
      "source": "/health",
      "destination": "https://apiforge-production-cb58.up.railway.app/health"
    },
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ]
}
