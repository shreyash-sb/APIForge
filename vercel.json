{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm --prefix Frontend install",
  "buildCommand": "npm --prefix Frontend run build",
  "outputDirectory": "Frontend/dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://apiforge-production-cb58.up.railway.app/api/:path*"
    },
    {
      "source": "/auth/:path*",
      "destination": "https://apiforge-production-cb58.up.railway.app/api/auth/:path*"
    },
    {
      "source": "/health",
      "destination": "https://apiforge-production-cb58.up.railway.app/health"
    },
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ]
}
