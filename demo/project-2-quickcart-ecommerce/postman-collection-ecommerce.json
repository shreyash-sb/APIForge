{
  "info": {
    "name": "Project 2: QuickCart E-Commerce Collection",
    "description": "Postman 2.1 formatted collection for QuickCart E-Commerce store demo endpoints.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. List Electronics Products (GET)",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Accept", "value": "application/json" }
        ],
        "url": {
          "raw": "http://localhost:3001/api/mock/serve/api/products?category=electronics&limit=10",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3001",
          "path": ["api", "mock", "serve", "api", "products"],
          "query": [
            { "key": "category", "value": "electronics" },
            { "key": "limit", "value": "10" }
          ]
        }
      }
    },
    {
      "name": "2. Get Product 201 (GET)",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Accept", "value": "application/json" }
        ],
        "url": {
          "raw": "http://localhost:3001/api/mock/serve/api/products/201",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3001",
          "path": ["api", "mock", "serve", "api", "products", "201"]
        }
      }
    },
    {
      "name": "3. Create Product (POST)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Wireless Gaming Mouse\",\n  \"price\": 59.99,\n  \"category\": \"electronics\",\n  \"inStock\": true\n}"
        },
        "url": {
          "raw": "http://localhost:3001/api/mock/serve/api/products",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3001",
          "path": ["api", "mock", "serve", "api", "products"]
        }
      }
    },
    {
      "name": "4. Place Order (POST)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"customerEmail\": \"customer@example.com\",\n  \"items\": [\n    {\n      \"productId\": 201,\n      \"quantity\": 1\n    }\n  ],\n  \"shippingAddress\": \"123 Technology Park, Mumbai\"\n}"
        },
        "url": {
          "raw": "http://localhost:3001/api/mock/serve/api/orders",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3001",
          "path": ["api", "mock", "serve", "api", "orders"]
        }
      }
    },
    {
      "name": "5. Track Order ORD-9021 (GET)",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Accept", "value": "application/json" }
        ],
        "url": {
          "raw": "http://localhost:3001/api/mock/serve/api/orders/ORD-9021",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3001",
          "path": ["api", "mock", "serve", "api", "orders", "ORD-9021"]
        }
      }
    },
    {
      "name": "6. Cancel Order (DELETE)",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "http://localhost:3001/api/mock/serve/api/orders/ORD-9021",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3001",
          "path": ["api", "mock", "serve", "api", "orders", "ORD-9021"]
        }
      }
    }
  ]
}
