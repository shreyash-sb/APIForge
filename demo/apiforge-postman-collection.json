            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": 101,\n  \"name\": \"Aarav Patil\",\n  \"email\": \"aarav@example.com\",\n  \"role\": \"student\",\n  \"active\": true\n}"
            },
            "url": {
              "raw": "http://localhost:3001/api/mock/serve/api/users/101",
              "protocol": "http",
