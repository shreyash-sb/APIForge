  "item": [
    {
      "name": "User Management",
      "item": [
        {
          "name": "1. Retrieve Users (GET)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "http://localhost:3001/api/mock/serve/api/users",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3001",
              "path": ["api", "mock", "serve", "api", "users"]
            }
          }
        },
        {
          "name": "2. Create User (POST)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Aarav Patil\",\n  \"email\": \"aarav@example.com\",\n  \"role\": \"student\",\n  \"active\": true\n}"
            },
            "url": {
              "raw": "http://localhost:3001/api/mock/serve/api/users",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3001",
              "path": ["api", "mock", "serve", "api", "users"]
            }
          }
        },
        {
